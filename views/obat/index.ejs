<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><title>Data Obat</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><div class="container mt-5">
    <h2>Daftar Inventaris Obat</h2>
    <a href="/obat/create" class="btn btn-primary mb-3">+ Tambah Obat</a>
    <div class="card shadow-sm"><div class="card-body">
        <table class="table table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nama Obat</th>
                    <th>Kategori</th>
                    <th>Stok</th>
                    <th>Harga Satuan</th>
                    <th>Kedaluwarsa</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (obat.length > 0) { %>
                    <% obat.forEach(o => { %>
                        <tr>
                            <td><%= o.id %></td>
                            <td><%= o.nama_obat %></td>
                            <td><%= o.kategori %></td>
                            <td><%= o.stok %></td>
                            <td>Rp <%= Number(o.harga_satuan).toLocaleString('id-ID') %></td>
                            <td><%= o.tanggal_kedaluwarsa ? o.tanggal_kedaluwarsa.toISOString().split('T')[0] : '-' %></td>
                            <td>
                                <a href="/obat/<%= o.id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/obat/<%= o.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Hapus obat ini?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %><tr><td colspan="7" class="text-center">Belum ada data obat.</td></tr><% } %>
            </tbody>
        </table>
    </div></div>
    <div class="mt-3"><a href="/" class="btn btn-secondary">Beranda</a></div>
</div></body>
</html>