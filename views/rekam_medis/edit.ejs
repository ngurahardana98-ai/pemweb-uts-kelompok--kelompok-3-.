<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><title>Edit Rekam Medis</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><div class="container mt-5" style="max-width: 600px;"><div class="card shadow-sm"><div class="card-body">
    <h3>Edit Rekam Medis</h3>
    <form action="/rekam-medis/<%= rekamMedis.id %>?_method=PUT" method="POST">
        <div class="mb-3"><label class="form-label">Pilih Pendaftaran</label>
            <select name="pendaftaran_id" class="form-select" required>
                <% pendaftaran.forEach(p => { %>
                    <option value="<%= p.id %>" <%= p.id === rekamMedis.pendaftaran_id ? 'selected' : '' %>><%= p.nama_pasien %> - <%= p.nama_dokter %></option>
                <% }) %>
            </select>
        </div>
        <div class="mb-3"><label class="form-label">Diagnosa</label><textarea name="diagnosa" class="form-control" rows="2" required><%= rekamMedis.diagnosa %></textarea></div>
        <div class="mb-3"><label class="form-label">Tindakan Medis</label><textarea name="tindakan" class="form-control" rows="2" required><%= rekamMedis.tindakan %></textarea></div>
        <div class="mb-3"><label class="form-label">Resep Obat</label><input type="text" name="resep_obat" class="form-control" value="<%= rekamMedis.resep_obat %>"></div>
        <button type="submit" class="btn btn-primary">Simpan Perubahan</button><a href="/rekam-medis" class="btn btn-secondary">Batal</a>
    </form>
</div></div></div></body>
</html>