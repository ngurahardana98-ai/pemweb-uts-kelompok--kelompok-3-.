<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><title>Rekam Medis</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><div class="container mt-5">
    <h2>Daftar Rekam Medis Pasien</h2>
    <a href="/rekam-medis/create" class="btn btn-primary mb-3">+ Tambah Rekam Medis</a>
    <div class="card shadow-sm"><div class="card-body">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Pasien</th>
                    <th>Dokter</th>
                    <th>Diagnosa</th>
                    <th>Tindakan</th>
                    <th>Resep Obat</th>
                    <th>Tanggal Periksa</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (rekamMedis.length > 0) { %>
                    <% rekamMedis.forEach(rm => { %>
                        <tr>
                            <td><%= rm.id %></td>
                            <td><%= rm.nama_pasien %></td>
                            <td><%= rm.nama_dokter %></td>
                            <td><%= rm.diagnosa %></td>
                            <td><%= rm.tindakan %></td>
                            <td><%= rm.resep_obat || '-' %></td>
                            <td><%= rm.tanggal_pemeriksaan ? rm.tanggal_pemeriksaan.toISOString().split('T')[0] : '-' %></td>
                            <td>
                                <a href="/rekam-medis/<%= rm.id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/rekam-medis/<%= rm.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Hapus rekam medis ini?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %><tr><td colspan="8" class="text-center">Belum ada rekam medis.</td></tr><% } %>
            </tbody>
        </table>
    </div></div>
    <div class="mt-3"><a href="/" class="btn btn-secondary">Beranda</a></div>
</div></body>
</html>