<!DOCTYPE html>
<html lang="id">
<head><meta charset="UTF-8"><title>Data Pendaftaran</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><div class="container mt-5">
    <h2>Daftar Pendaftaran Pasien</h2>
    <a href="/pendaftaran/create" class="btn btn-primary mb-3">+ Pendaftaran Baru</a>
    <div class="card shadow-sm"><div class="card-body">
        <table class="table table-striped">
            <thead class="table-dark"><tr><th>ID</th><th>Pasien</th><th>Dokter</th><th>Tanggal</th><th>Keluhan</th><th>Status</th><th>Aksi</th></tr></thead>
            <tbody>
                <% if (pendaftaran.length > 0) { %>
                    <% pendaftaran.forEach(item => { %>
                        <tr>
                            <td><%= item.id %></td><td><%= item.nama_pasien %></td><td><%= item.nama_dokter %></td>
                            <td><%= item.tanggal_daftar ? item.tanggal_daftar.toISOString().split('T')[0] : '-' %></td>
                            <td><%= item.keluhan %></td><td><span class="badge bg-info text-dark"><%= item.status %></span></td>
                            <td>
                                <a href="/pendaftaran/<%= item.id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/pendaftaran/<%= item.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Hapus data ini?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %><tr><td colspan="7" class="text-center">Belum ada pendaftaran.</td></tr><% } %>
            </tbody>
        </table>
    </div></div>
    <div class="mt-3"><a href="/" class="btn btn-secondary">Beranda</a></div>
</div></body>
</html>