<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Data Pasien - Sistem Klinik</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <h2 class="mb-4">Daftar Pasien Klinik</h2>
        <a href="/pasien/create" class="btn btn-primary mb-3">+ Tambah Pasien Baru</a>
        
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>NIK</th>
                            <th>Nama</th>
                            <th>JK</th>
                            <th>Tanggal Lahir</th>
                            <th>Telepon</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pasien.length > 0) { %>
                            <% pasien.forEach(p => { %>
                                <tr>
                                    <td><%= p.id %></td>
                                    <td><%= p.nik %></td>
                                    <td><%= p.nama %></td>
                                    <td><%= p.jenis_kelamin %></td>
                                    <td><%= p.tanggal_lahir ? p.tanggal_lahir.toISOString().split('T')[0] : '-' %></td>
                                    <td><%= p.no_telepon %></td>
                                    <td>
                                        <a href="/pasien/<%= p.id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                                        <form action="/pasien/<%= p.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Yakin ingin menghapus data ini?')">
                                            <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" class="text-center">Belum ada data pasien.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mt-3"><a href="/" class="btn btn-secondary">Kembali ke Beranda</a></div>
    </div>
</body>
</html>